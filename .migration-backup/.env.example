# ══════════════════════════════════════════════════════════════
#  VORTEX BM — Environment Variables Reference
#  Copy this file to .env.local and fill in the real values.
#  .env.local is gitignored and will NOT be committed.
#  On Vercel, add each variable in:
#    Project Settings → Environment Variables
# ══════════════════════════════════════════════════════════════

# ── Client-side (VITE_ prefix = exposed to the browser, safe to share) ──────
# Supabase project URL
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase anon / publishable key (safe to expose — enforces RLS)
VITE_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>

# ── Server-side (no VITE_ prefix = only available in API routes / server) ────
# ⚠ MUST be set for admin panel + avatar upload to work.
# Supabase project URL (same value as above — needed by the Express API server)
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase service-role / secret key (KEEP THIS SECRET — bypasses RLS)
# Find it in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your-service-role-key>
